[
  {
    "id": "chain-ethanol-to-ethyl-ethanoate",
    "title": "Ethanol to ethyl ethanoate",
    "chapters": ["Alcohols, Phenols & Ethers", "Carboxylic Acids & Derivatives"],
    "exam": ["JEE Main", "JEE Advanced"],
    "difficulty": "easy",
    "start": "CH3CH2OH",
    "startName": "ethanol",
    "steps": [
      {
        "reagent": "K2Cr2O7, H2SO4",
        "conditions": "heat",
        "product": "CH3COOH",
        "productName": "ethanoic acid",
        "distractors": ["CH3CHO", "CH3CH2OCH2CH3", "CH2=CH2"],
        "reaction": "Oxidation of a primary alcohol",
        "explanation": "Acidified dichromate oxidises ethanol all the way to the acid. The intermediate $\\ce{CH3CHO}$ is oxidised further under these conditions, so it is not isolated."
      },
      {
        "reagent": "CH3CH2OH, conc. H2SO4",
        "conditions": "heat",
        "product": "CH3COOCH2CH3",
        "productName": "ethyl ethanoate",
        "distractors": ["CH3COONa", "CH3CH2OCH2CH3", "CH3CONH2"],
        "reaction": "Fischer esterification",
        "explanation": "The acid catalyses the reaction of the carboxylic acid with ethanol to give the ester and water. $\\ce{CH3COONa}$ would form only with a base, and the ether $\\ce{CH3CH2OCH2CH3}$ is a dehydration product of ethanol alone."
      }
    ],
    "tags": ["oxidation", "esterification"]
  },
  {
    "id": "chain-ethene-to-ethanal",
    "title": "Ethene to ethanal",
    "chapters": ["Hydrocarbons", "Alcohols, Phenols & Ethers", "Aldehydes & Ketones"],
    "exam": ["JEE Main", "JEE Advanced"],
    "difficulty": "easy",
    "start": "CH2=CH2",
