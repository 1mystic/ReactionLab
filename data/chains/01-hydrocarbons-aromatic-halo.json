[
  {
    "id": "chain-propene-to-2-bromopropane",
    "title": "Propene to 2-bromopropane via the anti-Markovnikov route",
    "chapters": [
      "Hydrocarbons",
      "Haloalkanes & Haloarenes"
    ],
    "exam": [
      "JEE Main",
      "JEE Advanced"
    ],
    "difficulty": "easy",
    "start": "CH3CH=CH2",
    "startName": "propene",
    "steps": [
      {
        "reagent": "HBr, ROOR",
        "conditions": "",
        "product": "CH3CH2CH2Br",
        "productName": "1-bromopropane",
        "distractors": [
          "CH3CHBrCH3",
          "CH3CHBrCH2Br",
          "CH3CH2CH3"
        ],
        "reaction": "Peroxide effect (free radical addition)",
        "explanation": "In the presence of peroxide, HBr adds by a radical path so Br ends up on the less substituted carbon (anti-Markovnikov)."
      },
      {
        "reagent": "alc. KOH",
        "conditions": "heat",
        "product": "CH3CH=CH2",
        "productName": "propene",
        "distractors": [
          "CH3CH2CH2OH",
          "CH3CH2CH3",
          "CH3CHBrCH3"
        ],
        "reaction": "Dehydrohalogenation (E2)",
        "explanation": "Alcoholic KOH removes HBr to regenerate the alkene, whereas aqueous KOH would substitute to give an alcohol."
      },
      {
        "reagent": "HBr",
        "conditions": "",
        "product": "CH3CHBrCH3",
        "productName": "2-bromopropane",
        "distractors": [
          "CH3CH2CH2Br",
          "CH3CHBrCH2Br",
          "CH3CH(OH)CH3"
        ],
        "reaction": "Markovnikov addition",
        "explanation": "Without peroxide, H adds to the carbon bearing more hydrogens and Br goes to the secondary carbon via the more stable carbocation."
      }
    ],
    "tags": [
      "markovnikov",
      "peroxide effect",
      "elimination"
    ]
  },
